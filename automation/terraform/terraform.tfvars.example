subscription_id                = "794194cd-a4b7-4024-970c-9533c4babff0"
automation_resource_group_name = "rg-automation"
# Optional base name; a unique per-RG suffix is appended automatically.
# Defaults to "aa-law-retention" if you leave this out.
# automation_account_name      = "aa-law-retention"

# Optional. RFC3339, must be >5 minutes in the future. Leave commented to default
# to ~2 hours from apply time.
# schedule_start_time = "2026-08-01T03:00:00Z"

# ---- Retention the runbook applies to every table --------------------------
analytics_retention_in_days = -1
total_retention_in_days     = 730
workspace_name_filter       = ""

# Workspace-level default retention. 0 or -1 = leave unchanged; otherwise 30-730.
workspace_retention_in_days = -1
# Parallel table updates per workspace.
throttle_limit              = 10

# ---- Scope: which workspaces the runbook configures ------------------------
# ResourceGroup (default) | Subscription | ManagementGroup
scope_mode = "Subscription"

# Provide ONLY when scope_mode = "ResourceGroup": the resource group holding the
# Log Analytics workspaces to configure. (Still required by the config as a data
# source, so keep a valid RG name even for other scopes.)
target_resource_group_name = "rg-azure-monitor-lab"

# Provide ONLY when scope_mode = "Subscription" to target a DIFFERENT subscription
# than the Automation Account's own. Empty = the identity's home subscription.
scope_subscription_id = ""

# Provide ONLY when scope_mode = "ManagementGroup": the management group id/name
# the runbook enumerates.
scope_management_group = ""

# ---- RBAC: where to grant the identity Log Analytics Contributor ------------
# resource_group | subscription | management_group  (match this to scope_mode)
role_assignment_scope = "subscription"
# Required ONLY when role_assignment_scope = "management_group".
management_group_name = ""
