{
  "name": "b5f9e3d2-2c34-4d8b-ae6f-4a7b8c9d0e12",
  "type": "Microsoft.Authorization/policyDefinitions",
  "properties": {
    "displayName": "Configure Log Analytics table data retention (analytics and total retention)",
    "policyType": "Custom",
    "mode": "All",
    "description": "Governs analytics (retentionInDays) and total (totalRetentionInDays) retention of individual tables in Log Analytics workspaces. Provide a number of days to pin retention, or -1 for 'Same as workspace settings' (inherit the workspace default; long-term retention removed). Audit flags tables whose retention does not match; configuration is handled by the Automation runbook or script, not by policy remediation. Defaults to -1.",
    "metadata": {
      "category": "Monitoring",
      "version": "1.1.0",
      "source": "https://learn.microsoft.com/azure/azure-monitor/logs/data-retention-configure"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "The policy effect. Only Audit is supported: it reports tables whose retention does not match the specified values without changing anything."
        },
        "allowedValues": [
          "Audit"
        ],
        "defaultValue": "Audit"
      },
      "tableRetentionInDays": {
        "type": "Integer",
        "metadata": {
          "displayName": "Table analytics retention (days)",
          "description": "Analytics (interactive) retention in days for each table. Use -1 for 'Same as workspace settings' (inherit the workspace default). Otherwise the allowed range is 4-730. Defaults to -1."
        },
        "defaultValue": -1
      },
      "tableTotalRetentionInDays": {
        "type": "Integer",
        "metadata": {
          "displayName": "Table total retention (days)",
          "description": "Total retention in days (analytics + long-term) for each table. Use -1 for 'Same as workspace settings' (no long-term retention beyond the workspace default). Otherwise valid values are 4-730, or 1095, 1460, 1826, 2191, 2556, 2922, 3288, 3653, 4018, 4383. Defaults to -1."
        },
        "defaultValue": -1
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.OperationalInsights/workspaces/tables"
          },
          {
            "not": {
              "allOf": [
                {
                  "anyOf": [
                    {
                      "allOf": [
                        {
                          "value": "[parameters('tableRetentionInDays')]",
                          "equals": -1
                        },
                        {
                          "field": "Microsoft.OperationalInsights/workspaces/tables/retentionInDaysAsDefault",
                          "equals": true
                        }
                      ]
                    },
                    {
                      "field": "Microsoft.OperationalInsights/workspaces/tables/retentionInDays",
                      "equals": "[parameters('tableRetentionInDays')]"
                    }
                  ]
                },
                {
                  "anyOf": [
                    {
                      "allOf": [
                        {
                          "value": "[parameters('tableTotalRetentionInDays')]",
                          "equals": -1
                        },
                        {
                          "field": "Microsoft.OperationalInsights/workspaces/tables/totalRetentionInDaysAsDefault",
                          "equals": true
                        }
                      ]
                    },
                    {
                      "field": "Microsoft.OperationalInsights/workspaces/tables/totalRetentionInDays",
                      "equals": "[parameters('tableTotalRetentionInDays')]"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
